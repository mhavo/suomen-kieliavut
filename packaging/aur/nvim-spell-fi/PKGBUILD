# Maintainer: Miika Havo <miika.havo@gmail.com>

pkgname=nvim-spell-fi
pkgver=0.9
pkgrel=1
pkgdesc="Suomen oikolukusanasto Neovimille (fi.utf-8.spl, Ginterin koko sanasto)"
arch=('any')
url="https://github.com/mhavo/suomen-kieliavut"
# Käännetty :mkspell:llä dict/ginter/:stä. Johdannainen perii lähteensä
# lisenssin, ks. LICENSES.md.
license=('CC0-1.0')
depends=('neovim')
optdepends=('voikko-fi: morfologinen oikoluku työpöytäsovelluksiin — Neovim ei osaa sitä')
install="$pkgname.install"

_baseurl="https://github.com/mhavo/suomen-kieliavut/releases/download/v$pkgver"

source=("$pkgname-$pkgver-fi.utf-8.spl::$_baseurl/fi.utf-8.spl")

# Oikea summa, ei SKIP: muuttumaton tietotiedosto versioidun julkaisun takana,
# ei liikkuva git-viittaus. SKIP antaisi julkaisuomaisuuden korvaajalle vapaat
# kädet vaihtaa aineisto huomaamatta.
sha256sums=('eccc5b95edb4f49ca3ef9a322b40e2831d5919016eaa8bda57afed924cb91327')

package() {
    # ----------------------------------------------------------------------
    # Polkuvalinta on mitattu, ei arvattu.
    #
    # Neovim etsii oikolukusanastot 'runtimepath':ista hahmolla
    # spell/<kieli>.<koodaus>.spl. Tällä koneella (NVIM 0.12.5):
    #
    #   nvim --clean  ->  rtp sisältää /usr/share/nvim/site
    #                     (XDG_DATA_DIRS=/usr/local/share:/usr/share)
    #   käyttäjän oma LazyVim-kokoonpano
    #                 ->  rtp EI sisällä /usr/share/nvim/site:a lainkaan;
    #                     lazy.nvim kirjoittaa runtimepath'in uusiksi
    #
    # Molemmissa tapauksissa rtp sisältää /usr/share/nvim/runtime ($VIMRUNTIME).
    #
    # Paketti asentaa tiedoston VAIN polkuun /usr/share/nvim/site/spell/.
    # Se on Neovimin oma järjestelmänlaajuinen lisäyshakemisto ja kuuluu
    # tälle paketille kokonaan.
    #
    # Aiempi versio teki lisäksi symlinkin /usr/share/nvim/runtime/spell/:iin,
    # jotta sanasto löytyisi myös runtimepath'in nollaavista kokoonpanoista.
    # Se on poistettu kahdesta syystä:
    #   1. Hakemiston omistaa `neovim`-paketti. Toisen paketin hakemistoon
    #      kirjoittamisesta huomautetaan AUR-katselmuksessa.
    #   2. Se rikkoutuisi tiedostoristiriitana sinä päivänä, kun Neovim alkaa
    #      toimittaa oman fi.utf-8.spl:nsä.
    # runtimepath-ongelma on siirretty .install-viestiin käyttäjän
    # ratkaistavaksi — se on yhden rivin korjaus omassa kokoonpanossa.
    # ----------------------------------------------------------------------
    install -Dm644 "$srcdir/$pkgname-$pkgver-fi.utf-8.spl" \
        "$pkgdir/usr/share/nvim/site/spell/fi.utf-8.spl"
}
