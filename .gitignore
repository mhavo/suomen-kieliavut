# vaihtua ajossa.
build/fi-hunspell-9.9.oxt

handoff.md

# muuli workflow artifacts: committed by default. Only genuine ephemerals are
# ignored — each with a stated reason. <BASE> = .muuli-workflows
.muuli-workflows/**/spec-loop/     # redteam.md is deleted each round; never a deliverable
.muuli-workflows/audit-*/          # per-run raw working dir; the committed deliverable is the REMEDIATION plan
.muuli-workflows/**/*.handoff.md   # ralph transient coordination state, regenerated each handoff

# testi/-ajojen lokit
testi/tulokset/
